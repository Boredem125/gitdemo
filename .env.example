# Public base domain. Demos are served at <id>.$DOMAIN, the app at gitdemo.$DOMAIN (or $DOMAIN locally).
# Local: localhost   VM: 1-2-3-4.sslip.io (your public IP with dashes)
DOMAIN=localhost
PUBLIC_SCHEME=http
# Optional GitHub token (public repo read) to raise API limit 60 -> 5000 req/hr
GITHUB_TOKEN=
# runsc on the VM (gVisor), runc for local Docker Desktop
SANDBOX_RUNTIME=runc
DOCKER_HOST=
DEMO_NETWORK=gitdemo_demos
MAX_LIVE_DEMOS=6
MAX_CONCURRENT_BUILDS=2
DEMO_TTL_MIN=20
BUILD_TIMEOUT_MIN=10
DATA_DIR=./data
PORT=3000
