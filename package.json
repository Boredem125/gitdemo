{
  "name": "gitdemo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @gitdemo/api\" \"npm run dev -w @gitdemo/web\"",
    "build": "npm run build -w @gitdemo/web && npm run build -w @gitdemo/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5",
    "@types/node": "^22.13.1"
  },
  "engines": {
    "node": ">=22"
  }
}
